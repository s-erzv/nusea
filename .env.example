# Private data lives in the nuzas-office Neon project, schema `nusea`.
# Copy the pooled connection string from nuzas-office/.env, then run `pnpm db:setup`.
# Without DATABASE_URL the admin falls back to data/private/*.json.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Local development only: loopback + terminal token, no password.
ADMIN_LOCAL=1

# Online admin. Generate both with `pnpm admin:hash`.
ADMIN_PASSWORD_HASH=scrypt$SALT$HASH
ADMIN_SESSION_SECRET=change-me

# Publish from the host through GitHub + Netlify (no git checkout required).
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
GITHUB_TOKEN=github_pat_xxx
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxx

# Set on Render/Fly behind a proxy so secure cookies and client IPs work.
TRUST_PROXY=1
